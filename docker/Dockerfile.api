# Build from monorepo root (local/CI):
#   docker build -f docker/Dockerfile.api -t varnarc-api:local .
#
# Cloud Run may use docker/ as build context (~18 KB). When package.json is missing,
# this stage fetches the full repository from GitHub.
FROM alpine AS src
RUN apk add --no-cache curl tar git
WORKDIR /work
COPY . .
ARG REPO_URL=https://github.com/varnarc25-spec/varnarc
ARG GIT_REF=main
RUN if [ ! -f package.json ]; then \
      echo "package.json not in build context; fetching ${REPO_URL}@${GIT_REF}"; \
      rm -rf /work/* /work/.[!.]* 2>/dev/null || true; \
      if curl -fsSL "${REPO_URL}/archive/${GIT_REF}.tar.gz" | tar xz --strip-components=1; then \
        echo "Fetched source archive"; \
      else \
        git clone --depth 1 "${REPO_URL}.git" . && \
        (git fetch --depth 1 origin "${GIT_REF}" && git checkout FETCH_HEAD) || git checkout "${GIT_REF}"; \
      fi; \
    fi

FROM node:20-alpine AS base
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@9.6.0 --activate
WORKDIR /app

FROM base AS deps
COPY --from=src /work/package.json /work/pnpm-workspace.yaml /work/pnpm-lock.yaml* /work/turbo.json /work/tsconfig.base.json /work/.npmrc ./
COPY --from=src /work/apps/api/package.json apps/api/
COPY --from=src /work/packages/types/package.json packages/types/
COPY --from=src /work/packages/utils/package.json packages/utils/
COPY --from=src /work/packages/config/package.json packages/config/
COPY --from=src /work/packages/validation/package.json packages/validation/
COPY --from=src /work/packages/auth/package.json packages/auth/
COPY --from=src /work/packages/database/package.json packages/database/
COPY --from=src /work/packages/database/prisma packages/database/prisma
RUN pnpm install --frozen-lockfile || pnpm install

FROM deps AS build
COPY --from=src /work .
RUN pnpm --filter @varnarc/database generate
RUN pnpm --filter @varnarc/api... build
# Portable production bundle (resolves workspace:* deps without monorepo symlinks).
RUN pnpm deploy --filter=@varnarc/api --prod /deploy
# pnpm deploy copies @prisma/client but not the generated query engine. Copy from the
# monorepo install (generate ran above). Running prisma generate inside /deploy fails
# because there is no package.json and the CLI tries npm auto-install.
RUN set -e; \
    SRC_ROOT="$(dirname "$(find /app/node_modules/.pnpm -path '*/.prisma/client' -type d | head -n1)")"; \
    CLIENT_PKG="$(find /deploy/node_modules/.pnpm -path '*/@prisma/client' -type d | head -n1)"; \
    DEST_NODE_MODULES="$(dirname "$(dirname "$CLIENT_PKG")")"; \
    cp -r "$SRC_ROOT" "$DEST_NODE_MODULES/"; \
    test -f "$DEST_NODE_MODULES/.prisma/client/index.js" || (echo "ERROR: Prisma client not copied into deploy bundle" && exit 1)
# pnpm deploy --prod omits the Prisma CLI. Copy the CLI and its dependency
# closure as real directories. Copying only prisma/@prisma/engines leaves
# require('@prisma/debug') unresolved, so migrate deploy exits immediately.
RUN node <<'EOF'
const { spawnSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const store = '/app/node_modules/.pnpm';
const destRoot = '/deploy/node_modules';
const index = new Map();

function remember(name, dir) {
  let real = dir;
  try {
    real = fs.realpathSync(dir);
  } catch {
    return;
  }
  const score = real.split(`${path.sep}node_modules${path.sep}`).length;
  const prev = index.get(name);
  if (!prev || score < prev.score) index.set(name, { dir: real, score });
}

function walk(dir) {
  let entries;
  try {
    entries = fs.readdirSync(dir, { withFileTypes: true });
  } catch {
    return;
  }
  for (const ent of entries) {
    if (ent.name === '.bin') continue;
    const full = path.join(dir, ent.name);
    let isDir = ent.isDirectory();
    if (ent.isSymbolicLink()) {
      try {
        isDir = fs.statSync(full).isDirectory();
      } catch {
        isDir = false;
      }
    }
    if (!isDir) continue;
    if (ent.name !== 'node_modules') {
      walk(full);
      continue;
    }
    for (const child of fs.readdirSync(full, { withFileTypes: true })) {
      const childPath = path.join(full, child.name);
      if (child.name.startsWith('@')) {
        let scopeEntries;
        try {
          scopeEntries = fs.readdirSync(childPath, { withFileTypes: true });
        } catch {
          continue;
        }
        for (const pkg of scopeEntries) {
          const pkgDir = path.join(childPath, pkg.name);
          if (fs.existsSync(path.join(pkgDir, 'package.json'))) {
            remember(`${child.name}/${pkg.name}`, pkgDir);
          }
        }
      } else if (fs.existsSync(path.join(childPath, 'package.json'))) {
        remember(child.name, childPath);
      }
    }
  }
}

walk(store);

const copied = new Set();
function copyPkg(name) {
  if (copied.has(name)) return;
  copied.add(name);
  const hit = index.get(name);
  if (!hit) throw new Error(`Prisma CLI dependency not found in pnpm store: ${name}`);
  const dest = path.join(destRoot, name);
  if (!fs.existsSync(dest)) {
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    const result = spawnSync('cp', ['-aL', `${hit.dir}/.`, `${dest}/`], { stdio: 'inherit' });
    if (result.status !== 0) throw new Error(`Failed to copy ${name}`);
  }
  const pkg = JSON.parse(fs.readFileSync(path.join(hit.dir, 'package.json'), 'utf8'));
  for (const dep of Object.keys(pkg.dependencies || {})) copyPkg(dep);
}

copyPkg('prisma');
copyPkg('iconv-lite');

const binDir = path.join(destRoot, '.bin');
fs.mkdirSync(binDir, { recursive: true });
fs.writeFileSync(
  path.join(binDir, 'prisma'),
  '#!/bin/sh\nexec node "$(dirname "$0")/../prisma/build/index.js" "$@"\n',
);
fs.chmodSync(path.join(binDir, 'prisma'), 0o755);
EOF
RUN cd /deploy && node -e "require('@prisma/debug'); require('@prisma/engines'); require('@prisma/config')"
# dist/main.js requires express from the app root. pnpm deploy only links
# direct dependencies there, so express must stay in apps/api/package.json.
RUN cd /deploy && node -e "require('express')"

FROM node:20-alpine AS runner
RUN apk add --no-cache openssl
RUN addgroup -S varnarc && adduser -S varnarc -G varnarc
WORKDIR /app
ENV NODE_ENV=production
ENV SEARCH_ENGINE=postgres-fts

COPY --from=build --chown=varnarc:varnarc /deploy ./
COPY --from=src --chown=varnarc:varnarc /work/packages/database/prisma ./packages/database/prisma
ENV PRISMA_SCHEMA_PATH=/app/packages/database/prisma/schema.prisma

USER varnarc
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "const p=process.env.PORT||process.env.API_PORT||8080; fetch('http://127.0.0.1:'+p+'/api/v1/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/main.js"]
